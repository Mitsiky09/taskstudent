# Artéfacts de build Dart / Flutter — jamais versionnés.
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
doc/api/
coverage/
*.log

# Les dossiers de plateforme (android/, ios/, web/…) générés par
# `flutter create .` DOIVENT être versionnés pour une application : ils ne sont
# volontairement pas ignorés ici.

# Contrairement à un paquet de bibliothèque, une application versionne son
# pubspec.lock pour garantir des builds reproductibles.
