{
  "expo": {
    "name": "TaskStudent",
    "slug": "taskstudent",
    "scheme": "taskstudent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8fafc",
    "primaryColor": "#4f46e5",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr_FR"
      }
    },
    "android": {
      "package": "com.taskstudent.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      }
    }
  }
}
